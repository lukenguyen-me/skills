# Optional project config for /develop-feature
# Grok: copy to <repo>/.grok/develop-feature.toml and edit.
# Codex: copy to <repo>/.codex/develop-feature.toml; falls back to the Grok file.
# Omit any key you want inferred from the repo.

# Git
base_branch = "main"
parent_branch_template = "feat/{id}"
child_branch_template = "feat/{parent-id}-{child-id}"
# merge-no-ff | ff | commit-on-parent
integrate = "merge-no-ff"
# Default false: /implement commits on the parent feature branch, no per-child
# branch or per-child PR. Set true only if you want a branch per child.
child_branches = false

# Tickets. Leave empty to use docs/agents/issue-tracker.md when present.
# github | gitlab | local | auto
ticket_source = "auto"
local_tickets_root = ".scratch"

# Verification. Leave empty to discover from AGENTS.md, CLAUDE.md, package
# scripts, Makefile, justfile, pyproject, Cargo.toml, go.mod, and CI.
verify_commands = []
integration_verify_commands = []

# Human boundary
create_final_pr = false

# Extra skills the implementer should load when they exist in the session.
implementation_skills = ["tdd", "implement", "conventional-git"]
review_skills = ["code-review"]
